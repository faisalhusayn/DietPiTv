[Unit]
Description=Smart TV Kiosk Display Session (Direct X11)
After=network.target sound.target smart-tv.service
Wants=smart-tv.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smart-tv
ExecStart=/usr/bin/xinit /opt/smart-tv/scripts/start-kiosk.sh -- :0 -nocursor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
